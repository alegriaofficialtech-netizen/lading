{
  // Cloudflare Workers - site's de contenido estatico.
  //
  // El proyecto sirve HTML/CSS/JS puro desde la raiz del repositorio:
  // no hay paso de build, no hay dependencias, no hay framework.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lading",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./"
  }
}